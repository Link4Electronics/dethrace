#!/bin/sh
# Sourced by the AppImage AppRun at startup. Creates dethrace.ini with sane
# defaults in the user data dir (where the player drops their DATA/MUSIC) and
# changes the working directory there so the game picks it up.
dir=$DATADIR/dethrace
mkdir -p "$dir"
if [ ! -f "$dir"/dethrace.ini ]; then
cd "$dir"
cat <<EOM > "dethrace.ini"
[General]
; Enable original CD check
CdCheck = 0

; Enable original censorship check
GoreCheck = 0

; set to 0 to disable
FPSLimit = 60

; Full screen or window
Windowed = 1

; 3dfx mode (1 - OpenGL, 2 - SDL3 GPU)
Emulate3DFX = 2

; Censored zombie/robots mode
BoringMode = 0

; Play cut scenes on startup and between races
Cutscenes = 1

; "hires" mode is 640x480, otherwise default 320x200
Hires = 1

; Only used in 'demo' mode. Default demo time out is 240s (4 mins)
DemoTimeout = 240

; Which directory in the [Games] section to run
DefaultGame = c1

[Games]
c1 = .
c1demo = /opt/carma/c1demo
sp = /opt/carma/splatpack

[Cheats]
EditMode = 0
FreezeTimer = 0
GameCompleted = 0

[Sound]
Enabled = 1
SoundOptionsScreen = 1
VolumeMultiplier = 1

[Network]
AdapterName = ""
EOM
fi
cd "$dir"